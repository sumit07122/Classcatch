# ==========================================
# ClassCatch Environment Configuration
# ==========================================

# 1. Database Connection URL:
# Recommended 100% FREE PostgreSQL: Neon.tech (No credit card, 1-click GitHub login)
# Dashboard -> Connection Details -> Copy connection string:
# DATABASE_URL=postgresql://neondb_owner:npg_xxxxxx@ep-cool-brook-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Or local SQLite for quick offline testing:
DATABASE_URL=sqlite:///classcatch.db

# 2. Flask Secret Key (Use any secret string)
SECRET_KEY=classcatch-super-secret-production-key-2026

# 3. Google Play Store Android TWA Package ID
ANDROID_PACKAGE_NAME=com.classcatch.app
