# ==========================================
# ClassCatch Production Environment Variables
# ==========================================

# 1. Supabase PostgreSQL Connection String:
# Obtain from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Session mode, port 5432 or 6543)
# Example:
# DATABASE_URL=postgresql://postgres.yourprojectref:YourPasswordHere@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///classcatch.db

# 2. Flask Secret Key (Generate random hex in production)
SECRET_KEY=classcatch-super-secret-production-key-2026

# 3. Supabase REST API & Storage Credentials (Optional, for direct bucket uploads)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# 4. Google Play Store Android TWA Package ID
ANDROID_PACKAGE_NAME=com.classcatch.app
