# ===================================================
# ClassCatch — Production & Pilot Environment Example
# ===================================================

# 1. Database Connection URL (Neon Serverless PostgreSQL or local SQLite)
# Example: postgresql://username:password@ep-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///classcatch.db

# 2. Flask Application Secret Key (Generate a cryptographically strong 64-char string)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# 3. Storage Provider Configuration
# Supported providers: 'local', 's3', 'r2', 'neon'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads

# S3 / Cloudflare R2 / Neon Object Storage Settings (when STORAGE_PROVIDER is s3/r2/neon)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1

# 4. Institutional Pilot Settings
GLA_ALLOWED_DOMAIN=@gla.ac.in
ACTIVE_PILOT_SECTION=2FE
ALLOW_TEST_EMAILS=0

# 5. Mobile & Android TWA Settings
ANDROID_PACKAGE_NAME=com.classcatch.app
ANDROID_SHA256_FINGERPRINT=

# 6. AI Vision Whiteboard Scanner (Google Gemini API)
# Get a free key from https://aistudio.google.com
GEMINI_API_KEY=

# 7. Institutional Email Service (SMTP or Resend API)
# Option A: Standard SMTP (Gmail, SendGrid, Amazon SES, Brevo)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="ClassCatch GLA <noreply@classcatch.edu>"

# Option B: Resend API (Alternative to SMTP)
RESEND_API_KEY=
